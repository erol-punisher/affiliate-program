# Google OAuth client (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Restrict sign-in to accounts on this Google Workspace domain
ALLOWED_DOMAIN=shopcircle.co

# Random secret used to sign the session cookie (generate with: openssl rand -base64 32)
SESSION_SECRET=

