// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enum-like fields are stored as String and validated/typed via Zod in
// src/lib/rules — SQLite has no native enum type in Prisma.

// Per-person login allowlist, checked in the OAuth callback on top of the
// coarser ALLOWED_DOMAIN env var check. An empty table means the allowlist
// isn't enforced at all (falls back to domain-only) — so clearing it out
// can never lock everyone out by accident.
model AllowedUser {
  id    String @id @default(cuid())
  email String @unique

  addedBy String? // email of whoever added them, for provenance

  createdAt DateTime @default(now())
}

// Internal documentation entries — SOPs, process notes, decisions — shown as
// a reverse-chronological timeline in the Documentation section. Deliberately
// minimal for now (title + free-text body); structure (categories, tags,
// etc.) to be added once it's clear what's actually needed.
model DocumentationEntry {
  id String @id @default(cuid())

  title   String
  content String // markdown-ish free text

  author String? // email of whoever wrote/last edited it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Reusable message templates for outreach/onboarding "cadences" — e.g. a
// WhatsApp Day 0/3/5/7 onboarding sequence, or a cold-outreach follow-up
// sequence. Each cadence is an ordered list of template steps with plain
// {{placeholder}} text, meant to be copied straight into WhatsApp/email.
model TemplateCadence {
  id          String  @id @default(cuid())
  name        String
  description String?
  order       Int     @default(0)

  steps TemplateStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TemplateStep {
  id String @id @default(cuid())

  cadenceId String
  cadence   TemplateCadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  label   String // e.g. "Day 0 — Welcome message"
  content String // plain text with {{placeholder}} tokens
  order   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cadenceId])
}

// Custom pipeline-style stages for the main Affiliates dashboard. An
// affiliate's assigned stage is stored as plain text in a "Stage" column in
// the live Google Sheet (that dashboard has no other per-row DB linkage) —
// renaming or deleting a stage here bulk-syncs that column across the sheet
// so cells never go stale with a name that no longer exists.
model AffiliateStage {
  id    String @id @default(cuid())
  name  String @unique
  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Affiliate {
  id String @id @default(cuid())

  // Provenance: where this row came from in the original sheet, and the
  // untouched original values. Never mutated after import.
  sheetRowIndex Int?
  raw           String // JSON: the full original row as a { [header]: value } object

  // Normalized fields (Module A). Each has a companion *_raw when the source
  // text differs meaningfully from the typed value.
  name String

  commissionRate Float? // decimal rate, e.g. 0.15 for "15%"
  commissionRaw  String?

  tier           String? // AAA | AA | A | B | C | D
  tierRaw        String?
  tierConfidence String // "high" | "unmapped"

  status        String // ACTIVE | ACTIVE_NO_CONTRACT | INACTIVE | UNKNOWN
  statusRaw     String?
  statusFlagged Boolean @default(false) // true if a junk value was coerced to UNKNOWN

  language    String? // BCP-47, e.g. "pt-BR"
  languageRaw String?

  countryCode         String? // ISO-3166-1 alpha-2
  countryCodeInferred Boolean @default(false) // true if inferred from phone dial code

  phoneE164 String?
  phoneRaw  String?

  emails String // JSON: [{ address: string, isPrimary: boolean }]

  importArtifacts String // JSON string[]: field names nulled from #N/A / #ERROR! / junk

  healthScore Int @default(0) // 0-100, recomputed whenever normalization runs

  // Real product-usage events, entered by hand for now (no analytics/Shopify
  // Partners integration exists yet) — drive the Day 30 / Day 60 onboarding
  // auto-completion checks. Null until the event has actually happened.
  firstInstallAt      DateTime? // when this affiliate's first referred install was recorded
  firstPaidMerchantAt DateTime? // when this affiliate's first referred merchant converted to paid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issues              Issue[]
  duplicatesAsA       DuplicateCandidate[] @relation("DuplicateA")
  duplicatesAsB       DuplicateCandidate[] @relation("DuplicateB")
  auditEntries        AuditLog[]
  onboardingSteps     OnboardingStep[]
}

model Issue {
  id String @id @default(cuid())

  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  ruleId   String // e.g. "TIER_TRIM_WHITESPACE"
  severity String // "blocker" | "warning" | "info"
  field    String
  message  String

  status         String @default("open") // "open" | "resolved" | "exception"
  assignee       String?
  resolutionNote String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([affiliateId])
  @@index([status])
}

model DuplicateCandidate {
  id String @id @default(cuid())

  affiliateAId String
  affiliateA   Affiliate @relation("DuplicateA", fields: [affiliateAId], references: [id], onDelete: Cascade)
  affiliateBId String
  affiliateB   Affiliate @relation("DuplicateB", fields: [affiliateBId], references: [id], onDelete: Cascade)

  matchType       String // "code" | "email" | "phone"
  matchConfidence Float

  status     String    @default("pending") // "pending" | "merged" | "dismissed"
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
}

model AuditLog {
  id String @id @default(cuid())

  affiliateId String?
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  actor  String // user email
  action String // e.g. "normalize", "merge", "edit_field"
  field  String?

  beforeValue String? // JSON
  afterValue  String? // JSON

  createdAt DateTime @default(now())

  @@index([affiliateId])
}

// Editable default checklist template (Settings > Manage template UI). New
// steps for an affiliate are seeded from this table at "start onboarding"
// time; editing the template afterward never rewrites affiliates already
// mid-flow, since their rows snapshot label/order/targetDays/anchor at
// creation time.
model OnboardingStepTemplate {
  id String @id @default(cuid())

  key   String @unique
  label String
  order Int

  targetDays       Int
  targetDaysAnchor String  @default("step_start") // "step_start" | "approval"
  // At most one template row has this true — the step whose completedAt other
  // "approval"-anchored steps measure their target days from.
  isApprovalAnchor Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Post-signup onboarding checklist for an Affiliate. The default set of steps
// comes from OnboardingStepTemplate at creation time — `label`, `order`,
// `targetDays`, `targetDaysAnchor`, and `isApprovalAnchor` are snapshotted
// onto each row so a later template edit doesn't rewrite history for
// affiliates already mid-flow. Steps can also be added, renamed, retargeted,
// reordered, or removed per-affiliate (one-off cases), independent of the
// template.
model OnboardingStep {
  id String @id @default(cuid())

  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  stepKey String // matches a key in OnboardingStepTemplate, or a generated key for a per-affiliate custom step
  label   String
  order   Int

  status String  @default("not_started") // "not_started" | "in_progress" | "done" | "skipped"
  owner  String? // affiliate manager responsible for this step

  startedAt   DateTime?
  completedAt DateTime?
  targetDays  Int?
  targetDaysAnchor String  @default("step_start") // "step_start" | "approval"
  isApprovalAnchor Boolean @default(false)
  notes       String?

  // True when this step's completion was set by the automatic install/paying-
  // merchant check rather than a person — cleared the moment a human changes
  // this step's status themselves. Drives the "Auto" tag in the UI.
  autoCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activity OnboardingActivity[]

  @@unique([affiliateId, stepKey])
  @@index([affiliateId])
}

// One entry per field changed on an OnboardingStep — who changed it, what
// changed, and when — shown as a small activity log in the step's side panel.
model OnboardingActivity {
  id String @id @default(cuid())

  stepId String
  step   OnboardingStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  actor   String // user email
  message String // human-readable, e.g. "Status changed to Done"

  createdAt DateTime @default(now())

  @@index([stepId])
}

// CRM pipelines (replacing Bigin). A Lead is a pre-onboarding prospect card,
// separate from the Affiliate table — once signed, it's expected to graduate
// into a real Affiliate row rather than living in both places.
//
// Two-level structure matching Bigin: a PipelineGroup is a major category
// (e.g. "Affiliates"), which contains many named sub-pipelines/Pipelines
// (e.g. "Affiliates Standard", "Arab Influencers - Reach Out") — each its
// own board with its own stages.

model PipelineGroup {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  pipelines Pipeline[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Pipeline {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)
  // "regional" | "campaign", or null for a main overview pipeline (e.g. Affiliates Standard)
  category String?

  pipelineGroupId String
  pipelineGroup   PipelineGroup @relation(fields: [pipelineGroupId], references: [id], onDelete: Cascade)

  stages Stage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipelineGroupId])
}

model Stage {
  id    String  @id @default(cuid())
  name  String
  order Int
  color String? // "green" | "red" | null — for win/loss stages like Active/Closed Lost

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  leads Lead[]

  createdAt DateTime @default(now())

  @@index([pipelineId])
}

model Lead {
  id    String  @id @default(cuid())
  name  String // "Affiliate Name"
  firstName String? // how to greet them in emails ({{first_name}}); falls back to the first word of name
  email String? // "Email of Contact"
  notes String? // "Description"
  order Int     @default(0) // position within its stage column

  // Set when this card is a mirrored copy of another lead (e.g. the
  // Affiliates Standard overview holding a copy of every affiliate from
  // every niche/region sub-pipeline). Null for an organic, directly-created
  // lead. Self-referencing so a copy's source can be looked up or deleted
  // without touching the original.
  sourceLeadId String?
  sourceLead   Lead?   @relation("LeadCopy", fields: [sourceLeadId], references: [id], onDelete: SetNull)
  copies       Lead[]  @relation("LeadCopy")

  // Fields mirrored from the Bigin "Affiliate Information" record
  username         String?
  owner            String?
  affiliateManager String?
  country          String?
  whatsapp         String? // "WA"
  followerCount    Int?
  websiteUrl       String?
  referralLink     String?
  dateOfReachOut   DateTime?
  socialsUrl       String? // "URL of Socials"
  closingDate      DateTime?

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)

  stageEvents  LeadStageEvent[]
  emailThreads EmailThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId])
}

// One row per stage change (or initial placement) of a CRM lead, so weekly
// outreach numbers can be counted by when things happened rather than where
// leads sit today. Stage and pipeline names are copied in so history survives
// renames and deletions. rootLeadId is the original lead (sourceLeadId ?? id),
// letting a lead and its mirrored overview copy count as one affiliate.
model LeadStageEvent {
  id String @id @default(cuid())

  leadId     String?
  lead       Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  rootLeadId String

  pipelineName  String
  fromStageName String?
  toStageName   String
  actor         String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([rootLeadId])
}

// Small key/value store for app-wide settings edited from the UI (e.g. the
// weekly outreach targets, stored as JSON under "outreachTargets").
model AppSetting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// A dashboard user's Gmail access, granted via "Connect Gmail". The refresh
// token is AES-GCM encrypted with a key derived from SESSION_SECRET.
model GmailConnection {
  email                 String    @id
  encryptedRefreshToken String
  lastSyncAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Cache of Gmail label ids per mailbox, keyed by full label name
// (e.g. "CRM/EuroAffiliates ReachOut/Contacted (2)").
model GmailLabel {
  ownerEmail   String
  name         String
  gmailLabelId String

  @@id([ownerEmail, name])
}

// One Gmail thread started (or continued) from the dashboard with a CRM lead.
// leadId is the original lead (never a mirrored copy).
model EmailThread {
  id String @id @default(cuid())

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  ownerEmail      String
  gmailThreadId   String
  lastMessageId   String // RFC 822 Message-ID of our latest message, for threading follow-ups
  toEmail         String
  subject         String
  labelName       String?
  sentCount       Int       @default(1)
  lastSentAt      DateTime
  repliedAt       DateTime?
  // "interested" | "not_interested" | "out_of_office" | "wrong_person" | "unsubscribe"
  replyCategory   String?
  replySnippet    String?
  bouncedAt       DateTime?
  // Messages at or before this time are ignored by reply detection (e.g. one marked out-of-office).
  ignoreRepliesBefore DateTime?

  sends EmailSend[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerEmail, gmailThreadId])
  @@index([leadId])
}

// One row per email sent from the dashboard (a thread can have several).
// Drives the per-user daily cap and per-template reply stats.
model EmailSend {
  id String @id @default(cuid())

  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  ownerEmail     String
  leadId         String?
  templateStepId String?
  sentAt         DateTime @default(now())

  @@index([ownerEmail, sentAt])
  @@index([templateStepId])
}

// Do-not-contact list: an email address or a whole domain that the dashboard
// refuses to email (opt-outs, "not interested", bounces, manual entries).
model SuppressedContact {
  id      String  @id @default(cuid())
  value   String  @unique // lowercased email ("a@b.com") or domain ("b.com")
  kind    String // "email" | "domain"
  reason  String // "unsubscribe" | "not_interested" | "bounce" | "wrong_person" | "manual"
  addedBy String?

  createdAt DateTime @default(now())
}
